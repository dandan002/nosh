# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for billing: payment/check settlement and Stripe
# account state are written with the service role (see 0005_billing.sql).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Dashboard -> Developers -> API keys). The platform account; must
# have Connect enabled.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret(s), comma-separated if you register both a
# platform endpoint and a Connect (connected accounts) endpoint.
STRIPE_WEBHOOK_SECRET=
# Platform application fee in basis points of each pre-tip payment (100 = 1%).
PLATFORM_FEE_BPS=100

# Optional: absolute base URL for Stripe onboarding return links. Derived
# from the request when unset.
NEXT_PUBLIC_SITE_URL=
